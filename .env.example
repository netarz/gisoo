# Copy to .env (never commit .env). Create the key in the Gisoo app: https://gisoo.pro/app/api
GISOO_API_KEY=sk-gisoo-v1-your-key-here

# Optional overrides
GISOO_BASE_URL=https://gisoo.pro/api/v1
GISOO_MODEL=gpt-4o-mini

# The official OpenAI SDKs also read these two, so existing code can switch with no edits:
# OPENAI_API_KEY=sk-gisoo-v1-your-key-here
# OPENAI_BASE_URL=https://gisoo.pro/api/v1

# The official Anthropic SDKs and Claude Code read these (no /v1 at the end):
# ANTHROPIC_BASE_URL=https://gisoo.pro/api
# ANTHROPIC_AUTH_TOKEN=sk-gisoo-v1-your-key-here
